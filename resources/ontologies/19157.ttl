@prefix : <https://def.isotc211.org/ont/19157/> .
@prefix ont: <https://def.isotc211.org/ont/19157> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iso19103: <https://def.isotc211.org/ont/19103/> .
@prefix iso19115: <https://def.isotc211.org/ont/19115/> .
@prefix iso19103-ont: <https://def.isotc211.org/ont/19103> .
@prefix iso19115-ont: <https://def.isotc211.org/ont/19115> .
@base <https://def.isotc211.org/ont/19157/> .

<https://def.isotc211.org/ont/19157> rdf:type owl:Ontology ;
                                      dcterms:requires <https://def.isotc211.org/common/EvaluationMethodTypeCode> ,
                                                       <https://def.isotc211.org/common/FormulaLanguage> ,
                                                       <https://def.isotc211.org/common/ValueStructure> ;
                                      schema:citation "https://www.iso.org/standard/78900.html"^^xsd:anyURI ;
                                      schema:codeRepository "https://github.com/ISO-TC211/ontologies"^^xsd:anyURI ;
                                      schema:creator <https://def.isotc211.org/org/tc211> ;
                                      schema:dateCreated "2026-03-09"^^xsd:date ;
                                      schema:dateIssued "2000-01-01"^^xsd:date ;
                                      schema:dateModified "2026-03-09"^^xsd:date ;
                                      schema:description "ISO 19157 - Geographic information - Data quality - ontology" ;
                                      schema:isBasedOn <https://def.isotc211.org/common/standards/iso-19157-1-2023> ;
                                      schema:isPartOf <https://def.isotc211.org/ontologies> ;
                                      schema:license <https://rdflicense.linkeddata.es/rdflicense/cc-by4.0> ;
                                      schema:name "ISO 19157 - Geographic information - Data quality - ontology" ;
                                      schema:publisher <https://def.isotc211.org/org/tc211> ;
                                      schema:version "2023" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/requires
dcterms:requires rdf:type owl:AnnotationProperty .


###  https://schema.org/citation
schema:citation rdf:type owl:AnnotationProperty .


###  https://schema.org/codeRepository
schema:codeRepository rdf:type owl:AnnotationProperty .


###  https://schema.org/creator
schema:creator rdf:type owl:AnnotationProperty .


###  https://schema.org/dateCreated
schema:dateCreated rdf:type owl:AnnotationProperty .


###  https://schema.org/dateIssued
schema:dateIssued rdf:type owl:AnnotationProperty .


###  https://schema.org/dateModified
schema:dateModified rdf:type owl:AnnotationProperty .


###  https://schema.org/description
schema:description rdf:type owl:AnnotationProperty .


###  https://schema.org/isBasedOn
schema:isBasedOn rdf:type owl:AnnotationProperty .


###  https://schema.org/isPartOf
schema:isPartOf rdf:type owl:AnnotationProperty .


###  https://schema.org/license
schema:license rdf:type owl:AnnotationProperty .


###  https://schema.org/name
schema:name rdf:type owl:AnnotationProperty .


###  https://schema.org/publisher
schema:publisher rdf:type owl:AnnotationProperty .


###  https://schema.org/version
schema:version rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://def.isotc211.org/ont/19115/authority
iso19115:authority rdf:type owl:ObjectProperty ;
                   rdfs:domain iso19115:Identifier ;
                   rdfs:range iso19115:Citation ;
                   rdfs:isDefinedBy iso19115-ont: ;
                   schema:description "authority" ;
                   schema:name "authority" .


###  https://def.isotc211.org/ont/19115/describes
iso19115:describes rdf:type owl:ObjectProperty ;
                   rdfs:domain iso19115:Metadata ;
                   rdfs:range iso19115:Resource ;
                   rdfs:isDefinedBy iso19115-ont: ;
                   schema:description "describes" ;
                   schema:name "describes" .


###  https://def.isotc211.org/ont/19115/resultContent
iso19115:resultContent rdf:type owl:ObjectProperty ;
                       rdfs:domain :CoverageResult ;
                       rdfs:range iso19115:RangeDimension ;
                       rdfs:isDefinedBy iso19115-ont: ;
                       schema:description "result content" ;
                       schema:name "result content" .


###  https://def.isotc211.org/ont/19115/resultFormat
iso19115:resultFormat rdf:type owl:ObjectProperty ;
                      rdfs:domain :CoverageResult ;
                      rdfs:range iso19115:Format ;
                      rdfs:isDefinedBy iso19115-ont: ;
                      schema:description "result format" ;
                      schema:name "result format" .


###  https://def.isotc211.org/ont/19115/resultSpatialRepresentation
iso19115:resultSpatialRepresentation rdf:type owl:ObjectProperty ;
                                     rdfs:domain :CoverageResult ;
                                     rdfs:range iso19115:SpatialRepresentation ;
                                     rdfs:isDefinedBy iso19115-ont: ;
                                     schema:description "result spatial representation" ;
                                     schema:name "result spatial representation" .


###  https://def.isotc211.org/ont/19157/basicMeasure
:basicMeasure rdf:type owl:ObjectProperty ;
       rdfs:domain :QualityMeasure ;
       rdfs:range :BasicMeasure ;
       rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
       schema:description "basic measure" ;
       schema:name "basic measure" .


###  https://def.isotc211.org/ont/19157/citation
:citation rdf:type owl:ObjectProperty ;
          rdfs:domain :SourceReference ;
          rdfs:range iso19115:Citation ;
          rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
          schema:description "citation" ;
          schema:name "citation" .


###  https://def.isotc211.org/ont/19157/dataQualityInfo
:dataQualityInfo rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdfs:domain iso19115:Metadata ;
                 rdfs:range :DataQuality ;
                 rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                 schema:description "data quality info" ;
                 schema:name "data quality info" .


###  https://def.isotc211.org/ont/19157/derivedElement
:derivedElement rdf:type owl:ObjectProperty ;
                rdfs:domain :QualityElement ;
                rdfs:range :QualityElement ;
                rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                schema:description "derived element" ;
                schema:name "derived element" .


###  https://def.isotc211.org/ont/19157/description
:description rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain    [ rdf:type owl:Class ;
                              owl:unionOf ( :MeasureParameter
                                           :QualityMeasure
                                          )
                            ] ;
             rdfs:range :MeasureDescription ;
             rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
             schema:description "description" ;
             schema:name "description" .


###  https://def.isotc211.org/ont/19157/elementName
:elementName rdf:type owl:ObjectProperty ;
             rdfs:domain :QualityMeasure ;
             rdfs:range :TypeName ;
             rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
             schema:description "element name" ;
             schema:name "element name" .


###  https://def.isotc211.org/ont/19157/elementReport
:elementReport rdf:type owl:ObjectProperty ;
               rdfs:domain :QualityEvaluationReportInformation ;
               rdfs:range :QualityElement ;
               rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
               schema:description "element report" ;
               schema:name "element report" .


###  https://def.isotc211.org/ont/19157/evaluationMethod
:evaluationMethod rdf:type owl:ObjectProperty ;
                  rdfs:domain :QualityElement ;
                  rdfs:range :EvaluationMethod ;
                  rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                  schema:description "evaluation method" ;
                  schema:name "evaluation method" .


###  https://def.isotc211.org/ont/19157/evaluationMethodType
:evaluationMethodType rdf:type owl:ObjectProperty ;
                      rdfs:domain :EvaluationMethod ;
                      rdfs:range :EvaluationMethodTypeCode ;
                      rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                      schema:description "evaluation method type" ;
                      schema:name "evaluation method type" .


###  https://def.isotc211.org/ont/19157/evaluationProcedure
:evaluationProcedure rdf:type owl:ObjectProperty ;
                     rdfs:domain :EvaluationMethod ;
                     rdfs:range iso19115:Citation ;
                     rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                     schema:description "evaluation procedure" ;
                     schema:name "evaluation procedure" .


###  https://def.isotc211.org/ont/19157/example
:example rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf owl:topObjectProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :QualityMeasure 
                                     :BasicMeasure
                                   )
                     ] ;
         rdfs:range :MeasureDescription ;
         rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
         schema:description "example" ;
         schema:name "example" .


###  https://def.isotc211.org/ont/19157/extendedDescription
:extendedDescription rdf:type owl:ObjectProperty ;
                     rdfs:domain :MeasureDescription ;
                     rdfs:range iso19115:BrowseGraphic ;
                     rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                     schema:description "extended description" ;
                     schema:name "extended description" .


###  https://def.isotc211.org/ont/19157/formula
:formula rdf:type owl:ObjectProperty ;
         rdfs:domain :MeasureDescription ;
         rdfs:range :FormulaType ;
         rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
         schema:description "formula" ;
         schema:name "formula" .


###  https://def.isotc211.org/ont/19157/has
:has rdf:type owl:ObjectProperty ;
     rdfs:domain iso19115:Resource ;
     rdfs:range iso19115:Metadata ;
     rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
     schema:description "has" ;
     schema:name "has" .


###  https://def.isotc211.org/ont/19157/language
:language rdf:type owl:ObjectProperty ;
          rdfs:domain :FormulaType ;
          rdfs:range :FormulaLanguage ;
          rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
          schema:description "language" ;
          schema:name "language" .


###  https://def.isotc211.org/ont/19157/measure
:measure rdf:type owl:ObjectProperty ;
         rdfs:domain :QualityElement ;
         rdfs:range :MeasureReference ;
         rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
         schema:description "measure" ;
         schema:name "measure" .


###  https://def.isotc211.org/ont/19157/measureIdentification
:measureIdentification rdf:type owl:ObjectProperty ;
                       rdfs:domain :MeasureReference ;
                       rdfs:range iso19115:Identifier ;
                       rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                       schema:description "measure identification" ;
                       schema:name "measure identification" .


###  https://def.isotc211.org/ont/19157/measureIdentifier
:measureIdentifier rdf:type owl:ObjectProperty ;
                   rdfs:domain :QualityMeasure ;
                   rdfs:range iso19115:Identifier ;
                   rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                   schema:description "measure identifier" ;
                   schema:name "measure identifier" .


###  https://def.isotc211.org/ont/19157/onlineResource
:onlineResource rdf:type owl:ObjectProperty ;
                rdfs:domain :QualityEvaluationReportInformation ;
                rdfs:range iso19115:Resource ;
                rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                schema:description "online resource" ;
                schema:name "online resource" .


###  https://def.isotc211.org/ont/19157/parameter
:parameter rdf:type owl:ObjectProperty ;
       rdfs:domain :QualityMeasure ;
       rdfs:range :MeasureParameter ;
       rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
       schema:description "measure parameter" ;
       schema:name "measure parameter" . 


# Deleted :qualityElement. :report is the only relation specified between domain :DataQuality and range :QualityElement. :qualityElment is therefore redundant. I have removed it


###  https://def.isotc211.org/ont/19157/qualityEvaluationReport
:qualityEvaluationReport rdf:type owl:ObjectProperty ;
                         rdfs:domain :DataQuality ;
                         rdfs:range :QualityEvaluationReportInformation ;
                         rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                         schema:description "quality evaluation report" ;
                         schema:name "quality evaluation report" .


###  https://def.isotc211.org/ont/19157/referenceDoc
:referenceDoc rdf:type owl:ObjectProperty ;
              rdfs:domain :EvaluationMethod ;
              rdfs:range iso19115:Citation ;
              rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
              schema:description "reference doc" ;
              schema:name "reference doc" .


###  https://def.isotc211.org/ont/19157/relatedQualityElement
:relatedQualityElement rdf:type owl:ObjectProperty ;
                       rdfs:domain :Metaquality ;
                       rdfs:range :QualityElement ;
                       rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                       schema:description "related quality element" ;
                       schema:name "related quality element" .


###  https://def.isotc211.org/ont/19157/report
:report rdf:type owl:ObjectProperty ;
        rdfs:domain :DataQuality ;
        rdfs:range :QualityElement ;
        rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
        schema:description "report" ;
        schema:name "report" .


###  https://def.isotc211.org/ont/19157/report2
:report2 rdf:type owl:ObjectProperty ;
         rdfs:domain iso19115:Resource ;
         rdfs:range :QualityEvaluationReportInformation ;
         rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
         schema:description "report 2" ;
         schema:name "report 2" .


###  https://def.isotc211.org/ont/19157/reportReference
:reportReference rdf:type owl:ObjectProperty ;
                 rdfs:domain :QualityEvaluationReportInformation ;
                 rdfs:range iso19115:Citation ;
                 rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                 schema:description "report reference" ;
                 schema:name "report reference" .


###  https://def.isotc211.org/ont/19157/result
:result rdf:type owl:ObjectProperty ;
        rdfs:domain :QualityElement ;
        rdfs:range :QualityResult ;
        rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
        schema:description "result" ;
        schema:name "result" .


###  https://def.isotc211.org/ont/19157/resultScope
:resultScope rdf:type owl:ObjectProperty ;
             rdfs:domain :QualityResult ;
             rdfs:range iso19115:Scope ;
             rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
             schema:description "result scope" ;
             schema:name "result scope" .


###  https://def.isotc211.org/ont/19157/scope
:scope rdf:type owl:ObjectProperty ;
       rdfs:subPropertyOf owl:topObjectProperty ;
       rdfs:domain :DataQuality ;
       rdfs:range iso19115:Scope ;
       rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
       schema:description "scope" ;
       schema:name "scope" .


###  https://def.isotc211.org/ont/19157/sourceReference
:sourceReference rdf:type owl:ObjectProperty ;
       rdfs:domain :QualityMeasure ;
       rdfs:range :SourceReference ;
       rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
       schema:description "source reference" ; 
       schema:name "source reference" .


###  https://def.isotc211.org/ont/19157/spatialRepresentationType
:spatialRepresentationType rdf:type owl:ObjectProperty ;
                           rdfs:domain :CoverageResult ;
                           rdfs:range :SpatialRepresentationTypeCode ; 
                           rdfs:isDefinedBy iso19115-ont: ;
                           schema:description "spatial representation type" ;
                           schema:name "spatial representation type" .


###  https://def.isotc211.org/ont/19157/specification
:specification rdf:type owl:ObjectProperty ;
               rdfs:domain :ConformanceResult ;
               rdfs:range iso19115:Citation ;
               rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
               schema:description "specification" ;
               schema:name "specification" .


###  https://def.isotc211.org/ont/19157/value
:value rdf:type owl:ObjectProperty ;
       rdfs:domain :QuantitativeResult ;
       rdfs:range iso19103:Record ;
       rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
       schema:description "value" ;
       schema:name "value" .


###  https://def.isotc211.org/ont/19157/valueRecordType
:valueRecordType rdf:type owl:ObjectProperty ;
                 rdfs:domain :QuantitativeResult ;
                 rdfs:range iso19103:RecordType ;
                 rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                 schema:description "value record type" ;
                 schema:name "value record type" .


###  https://def.isotc211.org/ont/19157/valueStructure
:valueStructure rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :MeasureParameter
                                            :QualityMeasure
                                          )
                            ] ;
                rdfs:range :ValueStructure ;
                rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                schema:description "value structure" ;
                schema:name "value structure" .


###  https://def.isotc211.org/ont/19157/valueType
:valueType rdf:type owl:ObjectProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :BasicMeasure
                                       :MeasureParameter
                                       :QualityMeasure
                                     )
                       ] ;
           rdfs:range :TypeName ;
           rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
           schema:description "value type" ;
           schema:name "value type" .


###  https://def.isotc211.org/ont/19157/valueUnit
:valueUnit rdf:type owl:ObjectProperty ;
           rdfs:domain :QuantitativeResult ;
           rdfs:range :UnitOfMeasure ;
           rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
           schema:description "value unit" ;
           schema:name "value unit" .


#################################################################
#    Data properties
#################################################################

###  http://www.w3.org/2002/07/owl#topDataProperty
owl:topDataProperty rdf:type owl:DatatypeProperty ;
                    rdfs:isDefinedBy owl: ;
                    schema:description "top data property" ;
                    schema:name "top data property" .


###  https://def.isotc211.org/ont/19115/code
iso19115:code rdf:type owl:DatatypeProperty ;
              rdfs:domain iso19115:Identifier ;
              rdfs:range xsd:string ;
              rdfs:isDefinedBy iso19115-ont: ;
              schema:description "code" ;
              schema:name "code" .


###  https://def.isotc211.org/ont/19115/codeSpace
iso19115:codeSpace rdf:type owl:DatatypeProperty ;
                   rdfs:domain iso19115:Identifier ;
                   rdfs:range xsd:string ;
                   rdfs:isDefinedBy iso19115-ont: ;
                   schema:description "code space" ;
                   schema:name "code space" .


###  https://def.isotc211.org/ont/19115/description
iso19115:description rdf:type owl:DatatypeProperty ;
                     rdfs:domain iso19115:Identifier ;
                     rdfs:range xsd:string ;
                     rdfs:isDefinedBy iso19115-ont: ;
                     schema:description "description" ;
                     schema:name "description" .


###  https://def.isotc211.org/ont/19115/version
iso19115:version rdf:type owl:DatatypeProperty ;
                 rdfs:domain iso19115:Identifier ;
                 rdfs:range xsd:string ;
                 rdfs:isDefinedBy iso19115-ont: ;
                 schema:description "version" ;
                 schema:name "version" .


###  https://def.isotc211.org/ont/19157/abstract
:abstract rdf:type owl:DatatypeProperty ;
          rdfs:domain :QualityEvaluationReportInformation ;
          rdfs:range xsd:string ;
          rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
          schema:description "abstract" ;
          schema:name "abstract" .


###  https://def.isotc211.org/ont/19157/alias
:alias rdf:type owl:DatatypeProperty ;
       rdfs:domain :QualityMeasure ;
       rdfs:range xsd:string ;
       rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
       schema:description "alias" ;
       schema:name "alias" .


###  https://def.isotc211.org/ont/19157/dateTime
:dateTime rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :EvaluationMethod
                                      :QualityResult
                                    )
                      ] ;
          rdfs:range xsd:dateTime ;
          rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
          schema:description "date time" ;
          schema:name "date time" .


###  https://def.isotc211.org/ont/19157/deductiveSource
:deductiveSource rdf:type owl:DatatypeProperty ;
                 rdfs:domain :EvaluationMethod ;
                 rdfs:range xsd:string ;
                 rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                 schema:description "deductive source" ;
                 schema:name "deductive source" .


###  https://def.isotc211.org/ont/19157/definition
:definition rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :BasicMeasure
                                        :MeasureParameter
                                        :QualityMeasure
                                      )
                        ] ;
            rdfs:range xsd:string ;
            rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
            schema:description "definition" ;
            schema:name "definition" .


###  https://def.isotc211.org/ont/19157/evaluationMethodDescription
:evaluationMethodDescription rdf:type owl:DatatypeProperty ;
                             rdfs:domain :EvaluationMethod ;
                             rdfs:range xsd:string ;
                             rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                             schema:description "evaluation method description" ;
                             schema:name "evaluation method description" .


###  https://def.isotc211.org/ont/19157/explanation
:explanation rdf:type owl:DatatypeProperty ;
             rdfs:domain :ConformanceResult ;
             rdfs:range xsd:string ;
             rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
             schema:description "explanation" ;
             schema:name "explanation" .


###  https://def.isotc211.org/ont/19157/formulaType
:formulaType rdf:type owl:DatatypeProperty ;
             rdfs:isDefinedBy iso19103-ont: ;
             schema:description "formula type" ;
             schema:name "formula type" .


###  https://def.isotc211.org/ont/19157/key
:key rdf:type owl:DatatypeProperty ;
     rdfs:domain :FormulaType ;
     rdfs:range xsd:string ;
     rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
     schema:description "key" ;
     schema:name "key" .


