:languageVersion rdf:type owl:DatatypeProperty ;
                 rdfs:domain :FormulaType ;
                 rdfs:range xsd:string ;
                 rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                 schema:description "language version" ;
                 schema:name "language version" .


###  https://def.isotc211.org/ont/19157/lotDescription
:lotDescription rdf:type owl:DatatypeProperty ;
                rdfs:domain :SampleBasedInspection ;
                rdfs:range xsd:string ;
                rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                schema:description "lot description" ;
                schema:name "lot description" .


###  https://def.isotc211.org/ont/19157/mathematicalFormula
:mathematicalFormula rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf owl:topDataProperty ;
                     rdfs:domain :FormulaType ;
                     rdfs:range xsd:string ;
                     rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                     schema:description "mathematical formula" ;
                     schema:name "mathematical formula" .


###  https://def.isotc211.org/ont/19157/measureDescription
:measureDescription rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf owl:topDataProperty ;
                    rdfs:domain :MeasureReference ;
                    rdfs:range xsd:string ;
                    rdfs:isDefinedBy <https://def.isotc211.org/ont/19157> ;
                    schema:description "measure description" ;
                    schema:name "measure description" .


###  https://def.isotc211.org/ont/19157/name
:name rdf:type owl:DatatypeProperty ;
      rdfs:subPropertyOf owl:topDataProperty ;
